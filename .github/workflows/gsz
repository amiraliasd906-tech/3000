name: Build debug APK

# Runs automatically every time you push/upload to the main branch, and can
# also be triggered manually from the Actions tab ("Run workflow" button).
on:
  push:
    branches: [ "main", "master" ]
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Set up JDK 17
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: "17"

      - name: Set up Android SDK
        uses: android-actions/setup-android@v3

      - name: Build debug APK
        # This project's committed copy is missing gradle/wrapper/gradle-wrapper.jar
        # (the binary file ./gradlew itself needs to run) — very likely the real
        # cause of build failures. Rather than depend on that missing file, this
        # step installs Gradle directly (matching the version already pinned in
        # gradle/wrapper/gradle-wrapper.properties) and calls it straight, so the
        # build works whether or not the wrapper jar is present in the repo.
        #
        # cache-disabled: true is deliberate. setup-gradle otherwise persists the
        # Gradle User Home (including incremental Kotlin compilation state)
        # between workflow runs. A previously-cached, partially-invalidated
        # incremental build can make the Kotlin compiler resolve a symbol
        # (graphicsLayer, animateFloat, etc.) in one file but not another file
        # with the identical import in the same module — exactly the asymmetric
        # "Unresolved reference" pattern this project hit. Every run should
        # compile from a clean slate until this is proven stable.
        uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: "8.7"
          cache-disabled: true

      - name: Run build
        run: gradle clean assembleDebug --stacktrace --no-build-cache --rerun-tasks

      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: DivarSmartSearch-debug-apk
          path: app/build/outputs/apk/debug/app-debug.apk
